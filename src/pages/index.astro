---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { en } from '../i18n/en';
import { getCollection } from 'astro:content';
import { getPlaceOverviewExcerpt } from '../utils/placeContent';

const t    = en;
const lang = 'en';

const allWork = await getCollection('workPlaces');
const verifiedPlaces = allWork.filter(p => p.data.status === 'active' && p.data.wifi.down !== null);
const activeWork = verifiedPlaces
  .sort((a, b) => b.data.last_tested.localeCompare(a.data.last_tested))
  .slice(0, 3);

const mostRecent = verifiedPlaces
  .sort((a, b) => b.data.last_tested.localeCompare(a.data.last_tested))[0]?.data.last_tested;
const verifiedLabel = mostRecent
  ? new Date(mostRecent + 'T12:00:00').toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
  : 'Jul 2026';

const fastest = verifiedPlaces.reduce((best, p) => (p.data.wifi.down! > best.data.wifi.down! ? p : best), verifiedPlaces[0]);
---

<Base
  title="Cartagena Up — WiFi-Tested Cafés & Coworking in Cartagena"
  description="The only guide to Cartagena with real WiFi speed tests at verified cafés and coworking spaces — tested in person by local residents Yatan and Adri."
  lang="en"
  canonicalUrl="https://cartagenaup.com/">

  <!-- Dark hero — breaks out of main padding -->
  <section style="background: #1C1A17; margin: 0 -1.25rem; padding: 2.5rem 1.25rem 2rem;">
    <p style="font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #C45C26; margin: 0 0 0.875rem;">
      Cartagena de Indias · Verified {verifiedLabel}
    </p>
    <h1 style="font-family: Georgia, serif; font-weight: 400; font-size: clamp(2.2rem, 6vw, 3.2rem); line-height: 1.1; color: #FAF7F2; margin: 0 0 0.875rem;">
      Cartagena. <em style="font-style: italic; color: #C8943A;">Just updated.</em>
    </h1>
    <p style="font-size: 0.875rem; color: rgba(250,247,242,0.5); margin: 0 0 1.5rem; line-height: 1.55; max-width: 30rem;">
      Cafés and work spots with real, measured WiFi speeds — tested in person by people who live here.
    </p>
    <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.25rem; display: flex; gap: 2.5rem; flex-wrap: wrap;">
      <div>
        <span style="font-size: 1.5rem; font-weight: 700; color: #C8943A; font-variant-numeric: tabular-nums;">{verifiedPlaces.length}</span>
        <span style="font-size: 0.75rem; color: rgba(250,247,242,0.45); margin-left: 0.4rem;">verified spots</span>
      </div>
      <div>
        <span style="font-size: 1.5rem; font-weight: 700; color: #C8943A; font-variant-numeric: tabular-nums;">{Math.round(fastest.data.wifi.down!)} Mbps</span>
        <span style="font-size: 0.75rem; color: rgba(250,247,242,0.45); margin-left: 0.4rem;">fastest WiFi measured</span>
      </div>
    </div>
  </section>

  <!-- Work spots -->
  <section style="padding-top: 2.5rem;">
    <div class="section-label">WiFi-Tested Cafés & Coworking in Cartagena</div>
    <div>
      {activeWork.map(place => {
        const note = getPlaceOverviewExcerpt(place.body ?? '', 'en');
        return (
          <div style="padding: 0.625rem 0; border-bottom: 1px solid var(--border);">
            <div style="display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;">
              <a href={`/work/${place.data.slug}/`}
                style="font-family: Georgia, serif; font-size: 0.9375rem; color: var(--fg); text-decoration: none; font-weight: 400;">
                {place.data.name}
              </a>
              <span style="font-size: 0.75rem; color: var(--text-muted); flex: 1;">
                {place.data.neighborhood}
              </span>
              <div style="display: flex; gap: 1rem; white-space: nowrap;">
                <div style="display: flex; align-items: baseline; gap: 0.25rem;">
                  <span style="font-size: 0.625rem; color: var(--text-muted);">↓</span>
                  <span style="font-size: 1.125rem; font-weight: 600; color: var(--fg); font-variant-numeric: tabular-nums;">{Math.round(place.data.wifi.down!)}</span>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">Mbps</span>
                </div>
                <div style="display: flex; align-items: baseline; gap: 0.25rem;">
                  <span style="font-size: 0.625rem; color: var(--text-muted);">↑</span>
                  <span style="font-size: 1.125rem; font-weight: 600; color: var(--fg); font-variant-numeric: tabular-nums;">{Math.round(place.data.wifi.up!)}</span>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">Mbps</span>
                </div>
              </div>
            </div>
            {note && (
              <p style="font-size: 0.75rem; color: var(--text-muted); font-style: italic; line-height: 1.5; margin: 0.25rem 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                {note}
              </p>
            )}
          </div>
        );
      })}
    </div>
    <a href="/work/" style="font-size: 0.75rem; font-weight: 600; color: #C45C26; text-decoration: none; display: inline-block; margin-top: 0.875rem;">
      {t.home.seeAllSpots}
    </a>
  </section>

<!-- WiFi rankings -->
  <section style="padding-top: 2.5rem;">
    <div class="section-label">Compare WiFi Speeds</div>
    <div style="display: grid; gap: 0.5rem;">
      <a href="/work/fastest-wifi-cartagena/" style="font-family: Georgia, serif; font-size: 0.9375rem; color: var(--fg); text-decoration: none; padding: 0.625rem 0; border-bottom: 1px solid var(--border);">
        Fastest WiFi in Cartagena, ranked →
      </a>
      <a href="/work/wifi-speeds-cartagena/" style="font-family: Georgia, serif; font-size: 0.9375rem; color: var(--fg); text-decoration: none; padding: 0.625rem 0; border-bottom: 1px solid var(--border);">
        Every café's WiFi speed, side by side →
      </a>
    </div>
  </section>

  <WhatsAppCTA lang="en" />

  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Yatan",
      "description": "Cartagena resident since 2021, remote worker, and founder of Cartagena Up — a locally verified guide to cafés and coworking in Cartagena, Colombia.",
      "knowsAbout": [
        "Cartagena, Colombia",
        "Digital nomad life in Cartagena",
        "Coworking spaces in Cartagena",
        "WiFi speeds in Cartagena cafés",
        "Barú and Casa Gaviota"
      ],
      "sameAs": [
        "https://casagaviota.com"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Adri",
      "description": "Cartagena resident since 2010 and local contributor to Cartagena Up — verifying cafés, coworking spaces, and local knowledge in Cartagena, Colombia.",
      "knowsAbout": [
        "Cartagena, Colombia",
        "Cafés and coffee culture in Cartagena",
        "Local life and neighborhoods in Cartagena"
      ]
    }
  ])} />

</Base>
