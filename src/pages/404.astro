---
// Real 404 page. Without it, Cloudflare serves the homepage with a 200 for every unknown URL
// (soft 404s, duplicate content, and broken /.well-known/* checks by AI agents).
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist on Cartagena Up." lang="en" noindex>
  <div style="padding-top: 3rem;">
    <h1 style="font-family: Georgia, serif; font-weight: 400; font-size: 1.875rem; margin: 0 0 0.75rem; color: var(--fg);">
      Page not found
    </h1>
    <p style="font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1.5rem;">
      This page doesn't exist — it may have moved. · Esta página no existe — puede que se haya movido.
    </p>
    <p style="display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.875rem; font-weight: 600;">
      <a href="/work/" style="color: #C45C26; text-decoration: none;">Work spots →</a>
      <a href="/work/fastest-wifi-cartagena/" style="color: #C45C26; text-decoration: none;">Fastest WiFi →</a>
      <a href="/es/work/" style="color: #C45C26; text-decoration: none;">Lugares en español →</a>
    </p>
  </div>
</Base>
