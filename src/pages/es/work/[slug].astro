---
import Base from '../../../layouts/Base.astro';
import WhatsAppCTA from '../../../components/WhatsAppCTA.astro';
import PlaceCarousel from '../../../components/PlaceCarousel.jsx';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getWorkImage } from '../../../utils/images';
import { renderPlaceSection } from '../../../utils/renderPlaceSection';

export async function getStaticPaths() {
  const places = await getCollection('workPlaces');
  return places.map(place => ({
    params: { slug: place.data.slug },
    props: { place: place.data, body: place.body },
  }));
}

const { place, body } = Astro.props;
const lang = 'es';
const noteHtml = renderPlaceSection(body, 'es');

const resolvedImages = await Promise.all(
  (place.images || []).map(async (img) => {
    const src = getWorkImage(img.file);
    if (!src) return { ...img, url: null, webpUrl: null };
    const [webp, fallback] = await Promise.all([
      getImage({ src, width: 1200, format: 'webp' }),
      getImage({ src, width: 1200, format: 'jpeg' }),
    ]);
    return { ...img, url: fallback.src, webpUrl: webp.src };
  })
);

function shortDate(s) {
  const d = new Date(s + 'T12:00:00');
  return d.toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}

const metaDescription = place.wifi.down !== null
  ? `${place.name} — Lugar de trabajo con WiFi probado en ${place.neighborhood}, Cartagena. ${place.wifi.down}↓/${place.wifi.up}↑ Mbps, verificado ${shortDate(place.last_tested)}.`
  : `${place.name} — cerrado. Descubre qué saber sobre ${place.neighborhood}, Cartagena en su lugar.`;

const placeJsonLd = {
  "@context": "https://schema.org",
  "@type": place.type === 'coworking' ? "LocalBusiness" : "CafeOrCoffeeShop",
  "name": place.name,
  "url": `https://cartagenaup.com/es/work/${place.slug}/`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": place.address || place.neighborhood,
    "addressLocality": "Cartagena",
    "addressRegion": "Bolívar",
    "addressCountry": "CO"
  },
  ...(place.maps_link ? { "hasMap": place.maps_link } : {}),
  ...(place.hours ? { "openingHours": place.hours } : {}),
  "amenityFeature": [
    ...(place.wifi.down !== null ? [
      { "@type": "LocationFeatureSpecification", "name": "WiFi Bajada", "value": `${place.wifi.down} Mbps` },
      { "@type": "LocationFeatureSpecification", "name": "WiFi Subida", "value": `${place.wifi.up} Mbps` },
    ] : []),
    { "@type": "LocationFeatureSpecification", "name": "Aire Acondicionado", "value": place.workspace.ac === true },
    { "@type": "LocationFeatureSpecification", "name": "Enchufes", "value": place.workspace.outlets || "desconocido" },
  ],
  "description": metaDescription,
};
---

<Base
  title={place.name}
  description={metaDescription}
  lang="es"
  canonicalUrl={`https://cartagenaup.com/es/work/${place.slug}/`}
  additionalJsonLd={placeJsonLd}>

  <div style="padding-top: 1.5rem;">
    <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1.25rem;">
      <a href="/es/work/" style="color: #C45C26; text-decoration: none;">← Cafés y Coworking con WiFi Probado en Cartagena</a>
    </p>

    {resolvedImages.length > 0 && (
      <div style="margin-bottom: 1.5rem;">
        <PlaceCarousel client:visible images={resolvedImages} placeName={place.name} />
      </div>
    )}

    <div style="margin-bottom: 0.75rem;">
      <span style="display: inline-flex; align-items: center; gap: 0.25rem; background: #C45C26; color: #fff; font-size: 0.6rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.08em;">
        ✓ {shortDate(place.last_tested)}{place.tested_by ? ` · ${place.tested_by}` : ''}
      </span>
    </div>

    <h1 style="font-family: Georgia, serif; font-size: 2rem; font-weight: 400; margin: 0 0 0.25rem; line-height: 1.15; color: var(--fg);">
      {place.name}
    </h1>
    <p style="font-size: 0.8125rem; color: var(--text-muted); margin: 0 0 1.5rem;">
      {place.neighborhood}{place.address ? ` · ${place.address}` : ''}
    </p>

    <div style="border: 0.5px solid var(--card-border); border-radius: 10px; padding: 1rem 1.25rem; display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 1.5rem; background: var(--card-bg);">
      <div>
        <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">↓ Bajada</div>
        <div style="font-size: 2rem; font-weight: 700; line-height: 1; color: var(--fg);">
          {place.wifi.down ?? '—'}<span style="font-size: 0.875rem; font-weight: 400; color: var(--text-muted);"> Mbps</span>
        </div>
      </div>
      <div>
        <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">↑ Subida</div>
        <div style="font-size: 2rem; font-weight: 700; line-height: 1; color: var(--fg);">
          {place.wifi.up ?? '—'}<span style="font-size: 0.875rem; font-weight: 400; color: var(--text-muted);"> Mbps</span>
        </div>
      </div>
      {place.wifi.latency_ms && (
        <div>
          <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">Ping</div>
          <div style="font-size: 2rem; font-weight: 700; line-height: 1; color: var(--fg);">
            {place.wifi.latency_ms}<span style="font-size: 0.875rem; font-weight: 400; color: var(--text-muted);"> ms</span>
          </div>
        </div>
      )}
      <div>
        <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">AC</div>
        <div style={`font-size: 2rem; font-weight: 700; line-height: 1; color: ${place.workspace.ac ? '#16a34a' : 'var(--text-muted)'};`}>
          {place.workspace.ac ? '✓' : '—'}
        </div>
      </div>
    </div>

    {place.hotspot_warning && (
      <p style="font-size: 0.8125rem; background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; border-radius: 8px; padding: 0.625rem 1rem; margin-bottom: 1.25rem; line-height: 1.5;">
        ⚠ {place.hotspot_note?.es || 'Ten un hotspot de respaldo'}
      </p>
    )}

    <div class="place-note" set:html={noteHtml} />

    <div style="display: grid; gap: 0.625rem; margin-bottom: 1.75rem;">
      {place.hours && (
        <div style="border-left: 2px solid var(--border); padding-left: 0.875rem;">
          <p style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin: 0 0 0.15rem;">Horario</p>
          <p style="font-size: 0.875rem; color: var(--fg); margin: 0;">{place.hours}</p>
        </div>
      )}
      {place.workspace.outlets && (
        <div style="border-left: 2px solid var(--border); padding-left: 0.875rem;">
          <p style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin: 0 0 0.15rem;">Enchufes</p>
          <p style="font-size: 0.875rem; color: var(--fg); margin: 0;">{place.workspace.outlets}</p>
        </div>
      )}
      {place.workspace.noise && (
        <div style="border-left: 2px solid var(--border); padding-left: 0.875rem;">
          <p style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin: 0 0 0.15rem;">Ruido</p>
          <p style="font-size: 0.875rem; color: var(--fg); margin: 0;">{place.workspace.noise}</p>
        </div>
      )}
    </div>

    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem;">
      {place.maps_link && (
        <a href={place.maps_link} target="_blank" rel="noopener"
          style="display: inline-flex; align-items: center; gap: 0.375rem; background: #C45C26; color: white; text-decoration: none; padding: 0.625rem 1.125rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600;">
          📍 Ver en Google Maps
        </a>
      )}
      <a href={`https://wa.me/573163946401?text=${encodeURIComponent(place.whatsapp_update_text || `Actualización para ${place.name} en Cartagena Up`)}`}
        target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; border: 0.5px solid var(--card-border); color: var(--text-muted); text-decoration: none; padding: 0.625rem 1.125rem; border-radius: 8px; font-size: 0.875rem; background: var(--card-bg);">
        ¿Algo cambió?
      </a>
      <a href={`https://wa.me/?text=${encodeURIComponent(`${place.name} en ${place.neighborhood}, Cartagena — WiFi ${place.wifi.down ?? '?'}/${place.wifi.up ?? '?'} Mbps. Verificado por residentes locales. https://cartagenaup.com/es/work/${place.slug}/`)}`}
        target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; gap: 0.375rem; background: #25D366; color: white; text-decoration: none; padding: 0.625rem 1.125rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600;">
        Compartir en WhatsApp
      </a>
    </div>

    <WhatsAppCTA lang="es" />
  </div>

</Base>

<style>
  .place-note :global(p) {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .place-note :global(h3) {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-left: 2px solid #C45C26;
    padding-left: 0.875rem;
    margin: 1.25rem 0 0.375rem;
  }
</style>
